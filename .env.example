# Wash-Go Admin Panel Environment Configuration
# Primary environment variable: VITE_API_URL (VITE_API_BASE_URL is also supported as legacy fallback)

# Default staging backend for local development and testing:
VITE_API_URL=https://wash-go-api-hsvt.onrender.com
VITE_API_BASE_URL=https://wash-go-api-hsvt.onrender.com

# For running against a local Spring Boot backend instance:
# VITE_API_URL=http://localhost:8080
# VITE_API_BASE_URL=http://localhost:8080

# Production backend (for production deployment only):
# VITE_API_URL=https://wash-go-api.onrender.com
# VITE_API_BASE_URL=https://wash-go-api.onrender.com

